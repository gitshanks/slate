{
  "manifest_version": 3,
  "name": "Slate — Watch history sync",
  "short_name": "Slate",
  "version": "0.1.0",
  "description": "Push your Netflix, Prime Video, Hulu, and Disney+ watch history to your Slate watchlist with one click.",
  "action": {
    "default_title": "Slate sync",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.amazon.com/*",
    "*://*.primevideo.com/*",
    "*://*.hulu.com/*",
    "*://*.disneyplus.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/viewingactivity*"],
      "js": ["content/netflix.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.amazon.com/gp/video/library*",
        "*://*.primevideo.com/settings/watch-history*"
      ],
      "js": ["content/prime.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.hulu.com/*/watch-history*"],
      "js": ["content/hulu.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.disneyplus.com/watchlist*",
        "*://*.disneyplus.com/*/profile/watch-history*"
      ],
      "js": ["content/disney.js"],
      "run_at": "document_idle"
    }
  ]
}
