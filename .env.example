# slate — environment variables
#
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Required:    TMDB key (and Supabase keys for Vercel + managed Supabase).
# Recommended: OMDB key — drives the IMDb / Rotten Tomatoes / Metacritic
#              chips that show up across saved titles.

# ── Required ─────────────────────────────────────────────────────────

# TMDB v3 API key. Free and instant:
#   https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ── Recommended ──────────────────────────────────────────────────────

# OMDB API key — powers the IMDb rating, Rotten Tomatoes Tomatometer,
# and Metacritic Metascore on every saved title (poster cards, title
# detail, command palette, watched stats). Free tier is 1,000 lookups
# per day, which is plenty for a personal library.
#
# Skipping this won't crash the app, but every rating chip stays blank.
#   https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# ── AI search ────────────────────────────────────────────────────────
#
# Optional. When configured, unlocks AI search in the ⌘K palette: toggle
# the "Ask AI" pill (or hit ⌘⇧K) and type natural language ("feel-good
# 90s rom-coms", "Nolan thrillers", "cozy autumn mysteries"). Also drives
# live query suggestions while you type. Skip both blocks below and the
# palette works exactly like before — the AI toggle just isn't rendered.
#
# Two backends are supported. If both keys are set, OpenAI-compat wins;
# override with AI_PROVIDER=anthropic if you want Claude.

# ── OpenAI-compatible (recommended) ───────────────────────────────────
#
# Works with any OpenAI-compatible endpoint:
#   - Groq      (free tier, sub-second inference, recommended)
#   - OpenRouter (free tier across many open models)
#   - Ollama / LM Studio / vLLM / llama.cpp (self-hosted, requires GPU
#                                            for usable autocomplete)
#
# Defaults assume Groq + Llama 3.3 70B. To use Groq:
#   1. Grab a free key at https://console.groq.com/keys
#   2. Drop it into OPENAI_API_KEY below.
#   3. Done — leave the other two blank.
OPENAI_API_KEY=

# Default: https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1
OPENAI_BASE_URL=

# Default: llama-3.3-70b-versatile (Groq).
# OpenRouter examples: meta-llama/llama-3.3-70b-instruct:free
# Ollama examples:    llama3.3, qwen2.5:32b
OPENAI_MODEL=

# ── Anthropic (alternative) ──────────────────────────────────────────
#
# Use Claude instead. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-4-7. Try claude-haiku-4-5 for
# snappier and cheaper inference.
ANTHROPIC_MODEL=

# Optional. Force a specific provider when both keys are set.
#   AI_PROVIDER=openai      # use OpenAI-compatible endpoint (default)
#   AI_PROVIDER=anthropic   # use Claude
AI_PROVIDER=

# ── Database ─────────────────────────────────────────────────────────
#
# The app talks to Postgres through one seam (lib/supabase.ts) and picks a
# backend by env var, in this precedence order:
#
#   1. DATABASE_URL            → Neon / any Postgres (recommended for Vercel:
#                                serverless, free tier, never pauses)
#   2. SUPABASE_URL + key      → hosted Supabase, or the compose self-host stack
#   3. (neither)               → no-op stub (renders empty states)

# Neon Postgres connection string. Provision via the Vercel Marketplace
# (Storage → Neon) and it's injected automatically; for local dev paste the
# pooled connection string here. Use the POOLED URL (host contains "-pooler")
# with `?sslmode=require`. Takes precedence over SUPABASE_URL when set.
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ── Hosted accounts (slate.nishh.dev) ───────────────────────────────
#
# Leave these unset for the original self-hosted single-user app.
# Set hosted mode to mount the marketing page at /, the signed-in app at
# /app, and require Google auth for every private library route.
NEXT_PUBLIC_SLATE_HOSTED=

# Auth.js secret. Generate once with: npx auth secret
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client.
# Authorized redirect URI:
#   https://your-domain.example/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Canonical public origin used when composing share links.
NEXT_PUBLIC_SITE_URL=

# Optional one-time bridge for a library created before accounts. On this
# Google email's first sign-in, rows owned by "self-hosted" are claimed.
SLATE_LEGACY_OWNER_EMAIL=

# docker-compose self-host: leave these unset — compose wires them up.
# Vercel + managed Supabase: paste your project URL and service_role key.
#   https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ─────────────────────────────────────────────────────────

# Gate the app behind a shared passcode. Leave blank to run open.
APP_PASSCODE=

# Set to 1 to run in demo mode (synthetic library, all changes live in
# the visitor's browser). Useful for a public portfolio deployment.
NEXT_PUBLIC_DEMO_MODE=

# ── docker-compose only ──────────────────────────────────────────────

# Postgres password used by the postgres + postgrest services.
POSTGRES_PASSWORD=slate

# Host port to expose the app on (defaults to 3000).
SLATE_PORT=3000
